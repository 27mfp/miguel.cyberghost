{
  "schemaVersion": 1,
  "id": "miguel.cyberghost",
  "name": "CyberGhost VPN",
  "version": "1.4.3",
  "author": "Miguel",
  "license": "MIT",
  "description": "CyberGhost VPN status, quick connect, country switching, and server mode controls in the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "CyberGhost VPN",
    "description": "Toggle CyberGhost VPN, switch countries, choose server type, and view active IP.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 8,
      "defaultCountry": "PT",
      "serverSelection": "fastest",
      "protocol": "wireguard",
      "serverType": "traffic",
      "hideDetails": false,
      "reduceMotion": false
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 60,
        "step": 1,
        "defaultValue": 8
      },
      {
        "key": "defaultCountry",
        "type": "string",
        "label": "Default Country",
        "defaultValue": "PT"
      },
      {
        "key": "serverSelection",
        "type": "string",
        "label": "Server selection (fastest or exact instance)",
        "description": "Use the lowest-load server or a specific server returned by CyberGhost.",
        "defaultValue": "fastest"
      },
      {
        "key": "protocol",
        "type": "string",
        "label": "VPN Protocol (wireguard or openvpn)",
        "defaultValue": "wireguard"
      },
      {
        "key": "serverType",
        "type": "string",
        "label": "Server type (traffic, torrent or streaming)",
        "defaultValue": "traffic"
      },
      {
        "key": "hideDetails",
        "type": "boolean",
        "label": "Hide IP and connection details",
        "description": "Mask IP, location, provider and session info in the widget panel.",
        "defaultValue": false
      },
      {
        "key": "reduceMotion",
        "type": "boolean",
        "label": "Reduce connection animations",
        "description": "Disable pulsing connection indicators.",
        "defaultValue": false
      }
    ]
  }
}
