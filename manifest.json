{
  "schemaVersion": 1,
  "id": "miguel.cyberghost",
  "name": "CyberGhost VPN",
  "version": "1.6.2",
  "author": "Miguel",
  "license": "MIT",
  "description": "Native CyberGhost WireGuard connections and country switching in the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "CyberGhost VPN",
    "description": "Choose a country and connect with native WireGuard and automatic server selection.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 8,
      "defaultCountry": "PT",
      "hideDetails": false,
      "reduceMotion": false
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 60,
        "step": 1,
        "defaultValue": 8
      },
      {
        "key": "defaultCountry",
        "type": "string",
        "label": "Default country",
        "defaultValue": "PT"
      },
      {
        "key": "hideDetails",
        "type": "boolean",
        "label": "Hide IP and connection details",
        "description": "Mask IP, location, provider and session info in the widget panel.",
        "defaultValue": false
      },
      {
        "key": "reduceMotion",
        "type": "boolean",
        "label": "Reduce connection animations",
        "description": "Disable pulsing connection indicators.",
        "defaultValue": false
      }
    ]
  }
}
