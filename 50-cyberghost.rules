/* Polkit rule for CyberGhost VPN Omarchy plugin.
 *
 * Allows members of the wheel group to run the root-owned helper without a
 * password prompt. The helper itself accepts only fixed connect/disconnect
 * lifecycle operations and derives the caller's config from PKEXEC_UID; it
 * rejects all other actions and custom paths.
 *
 * Pinned strictly to the fixed root-owned binary /usr/local/bin/cyberghost-runner,
 * preventing arbitrary command or Python script injection.
 *
 * Install with the repository installer, which snapshots and verifies both
 * files before installing them as root:
 *   bash ./install-helper.sh
 */
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.policykit.exec" &&
        action.lookup("program") === "/usr/local/bin/cyberghost-runner" &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
